<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>ImageOptim</AssemblyName>
    <RootNamespace>ImageOptim</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 版本号单一来源：imageoptim/release.xcconfig 的 CURRENT_PROJECT_VERSION（macOS 版也用它）。
         以前这里硬编码 1.0.0，与 macOS 版长期脱节，无法判断 Windows 端对应哪个功能基线。 -->
    <MacVersionConfig>$(MSBuildProjectDirectory)\..\..\imageoptim\release.xcconfig</MacVersionConfig>
    <Version Condition="Exists('$(MacVersionConfig)')">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MacVersionConfig)')), 'CURRENT_PROJECT_VERSION\s*=\s*([0-9]+(\.[0-9]+)*)').Groups[1].Value)</Version>
    <!-- 解析失败时兜底，避免把空版本号写进程序集 -->
    <Version Condition="'$(Version)' == ''">0.0.0</Version>
    <Authors>ImageOptim Contributors</Authors>
    <Product>ImageOptim</Product>
    <Description>Windows 版图片无损压缩工具，仿照 ImageOptim 界面与功能实现</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- 工具二进制：构建时若已下载则拷贝到输出目录，并与可执行文件同目录 -->
  <ItemGroup>
    <None Include="Tools\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('Tools')" />
  </ItemGroup>

  <!-- 构建时自动下载 Windows 版工具二进制（可选，通过 -p:DownloadTools=false 关闭）。
       仅当关键工具缺失时才执行：旧实现在每次 BeforeBuild 无条件启动一次 PowerShell
       （脚本内还有十余次 Test-Path），增量编译也要白等几秒到几十秒。 -->
  <Target Name="DownloadOptimizerTools"
          BeforeTargets="BeforeBuild"
          Condition="'$(DownloadTools)' != 'false' and (!Exists('$(MSBuildProjectDirectory)\Tools\oxipng.exe') or !Exists('$(MSBuildProjectDirectory)\Tools\cjpegli.exe'))">
    <Message Importance="high" Text="正在准备图片优化工具二进制文件..." />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\tools\download-tools.ps1&quot; -Destination &quot;$(MSBuildProjectDirectory)\Tools&quot;" ContinueOnError="true" />
  </Target>

</Project>
