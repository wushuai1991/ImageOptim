<Window x:Class="ImageOptim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ImageOptim"
        Title="ImageOptim" Height="480" Width="760"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        Background="#F5F5F7"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:StatusToSymbolConverter x:Key="StatusSymbol" />
        <local:StatusToBrushConverter x:Key="StatusBrush" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部提示栏 -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <StackPanel Margin="16,14" Orientation="Horizontal">
                <TextBlock x:Name="DropHintText" Text="将图片文件或文件夹拖放到此处，或点击下方按钮选择文件"
                           FontSize="13" Foreground="#555555" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 文件列表 -->
        <DataGrid Grid.Row="1"
                  x:Name="FileGrid"
                  ItemsSource="{Binding Items}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Extended"
                  GridLinesVisibility="None"
                  Background="#FFFFFF"
                  RowBackground="#FFFFFF"
                  AlternatingRowBackground="#FAFAFA"
                  BorderThickness="0"
                  EnableRowVirtualization="True"
                  AllowDrop="True"
                  DragOver="Window_DragOver"
                  Drop="Window_Drop">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="32" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StatusImage, Converter={StaticResource StatusSymbol}}"
                                       Foreground="{Binding StatusImage, Converter={StaticResource StatusBrush}}"
                                       FontSize="14" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="文件" Binding="{Binding FileName}" Width="*" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Padding" Value="4,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="150" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="优化后大小" Binding="{Binding ByteSizeOptimizedText}" Width="110" IsReadOnly="True" />
                <DataGridTextColumn Header="原始大小" Binding="{Binding ByteSizeOriginalText}" Width="110" IsReadOnly="True" />
                <DataGridTextColumn Header="节省" Binding="{Binding PercentOptimizedText}" Width="90" IsReadOnly="True" />
                <DataGridTextColumn Header="最佳工具" Binding="{Binding BestToolName}" Width="150" IsReadOnly="True" />
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="MinHeight" Value="30" />
                    <Setter Property="ToolTip" Value="{Binding StatusText}" />
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <!-- 状态栏与按钮 -->
        <Border Grid.Row="2" Background="#F0F0F0" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid Margin="16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" Text="" FontSize="12" Foreground="#333333"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="添加文件" Click="BrowseFiles_Click" Padding="12,6" Margin="0,0,8,0" />
                    <Button Content="停止" Click="Stop_Click" Padding="12,6" Margin="0,0,8,0" />
                    <Button Content="重新优化" Click="StartAgain_Click" Padding="12,6" Margin="0,0,8,0" />
                    <Button Content="清除已完成" Click="ClearComplete_Click" Padding="12,6" Margin="0,0,8,0" />
                    <Button Content="回退" Click="Revert_Click" Padding="12,6" Margin="0,0,8,0" />
                    <Button Content="偏好设置" Click="ShowPrefs_Click" Padding="12,6" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
